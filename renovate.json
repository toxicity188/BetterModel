{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": [
        "config:recommended"
    ],
    "ignoreDeps": [
        "org.jetbrains:annotations",
        "net.fabricmc.fabric-api:fabric-api",
        "net.fabricmc.fabric-loom-repositories"
    ],
    "baseBranches": [
        "v3-dev"
    ],
    "packageRules": [
        {
            "matchPackageNames": [
                "com.viaversion:viaversion-api"
            ],
            "registryUrls": [
                "https://repo.viaversion.com"
            ],
            "versioning": "semver"
        },
        {
            "matchPackageNames": [
                "com.github.SkriptLang:Skript"
            ],
            "registryUrls": [
                "https://repo.skriptlang.org/releases"
            ],
            "versioning": "semver"
        }
    ]
}
